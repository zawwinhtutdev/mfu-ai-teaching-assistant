# Copy to .env for local runs of the API service only.
# Docker Compose passes these in from the repo-root .env.local instead.

# Supabase project (auth only in this phase)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=local-demo-anon-key-placeholder

# Either set the legacy HS256 shared secret...
# SUPABASE_JWT_SECRET=
# ...or leave it empty and let the service fetch the project JWKS.

JWT_AUDIENCE=authenticated
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=local
