# Copy to .env.local for local development and Compose builds.
# Never commit real values.

# ---- Supabase (auth only in this phase) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: legacy HS256 project secret. Leave empty to use JWKS verification.
SUPABASE_JWT_SECRET=

# ---- AI ----
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_API_KEY=

# ---- Ops ----
# Bearer token for /api/notifications/process (GitHub Actions scheduled job)
CRON_SECRET=
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=local

# ---- Platform profile (Postgres) ----
POSTGRES_PASSWORD=ata-local-dev

# ---- API service (phase 3) ----
# Where the Next.js proxy forwards chat requests.
API_SERVICE_URL=http://127.0.0.1:8000
DEV_PRINCIPAL=demo.student@mfu.ac.th
# Local-only escape hatch: accept X-Dev-Principal instead of a Supabase token.
# Never enable in production; the API refuses to start if you do.
ALLOW_INSECURE_DEV_AUTH=true

# ---- Data (phase 4) ----
# Local Compose Postgres (start with --profile platform)
DATABASE_URL=postgresql+asyncpg://ata:ata-local-dev@127.0.0.1:5432/ata
EMBEDDING_MODEL=text-embedding-004

# ---- Retrieval / grounding (phase 5) ----
TOP_K=5
CONTEXT_CHARS=2400
# Cosine similarity below which the answer is refused. 0 disables the gate.
# Only meaningful with a semantic embedding model (not the offline stub).
REFUSAL_THRESHOLD=0.50
