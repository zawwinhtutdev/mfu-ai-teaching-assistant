# Production environment for the VPS stack.
#
#   cp .env.production.example .env.production
#   chmod 600 .env.production
#
# Read by docker-compose.prod.yml. NOT read by `next dev` — local development
# uses .env.local.
#
# NEXT_PUBLIC_* values are INLINED INTO THE BROWSER BUNDLE at build time.
# Changing either of them requires `docker compose build`, not a restart.

# Must be exactly "production". /api/health applies its strict checks (no
# loopback Supabase URL, no insecure dev auth) only when this is set, and
# scripts/deploy.sh refuses to run without it.
ENVIRONMENT=production


# ─────────────────────────────────────────────────────────────
# Supabase Cloud — required, not optional
#
# The app never opens a direct Postgres connection; all data access, auth,
# RLS, and file storage go through this project. A local database cannot
# substitute for it.
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — treat exactly like a root password.
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────
# AI — cloud API, no models on this server
# ─────────────────────────────────────────────────────────────
AI_PROVIDER=gemini
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional alias read by some code paths.
GOOGLE_API_KEY=

# ─────────────────────────────────────────────────────────────
# Site address for Caddy
#
# Use the real hostname so Caddy can obtain a certificate:
#   SITE_ADDRESS=ata.mfu.ac.th
# Use :80 to serve plain HTTP while verifying (no TLS).
# ─────────────────────────────────────────────────────────────
SITE_ADDRESS=ata.mfu.ac.th
ACME_EMAIL=admin@mfu.ac.th

# ─────────────────────────────────────────────────────────────
# Notifications
# ─────────────────────────────────────────────────────────────
# Bearer token for /api/notifications/process (GitHub Actions cron).
# Generate with: openssl rand -hex 32
CRON_SECRET=
# Comma-separated addresses allowed to hold the admin role.
ADMIN_EMAILS=admin@mfu.ac.th

# ─────────────────────────────────────────────────────────────
# DO NOT SET
#
# ALLOW_INSECURE_DEV_AUTH=true
#   Mints a passwordless admin session cookie. In production this is a full
#   authentication bypass. /api/health reports the deployment as degraded if
#   it is set, and the FastAPI service refuses to boot with it.
#
# DEV_PRINCIPAL=
#   Only meaningful alongside the flag above.
# ─────────────────────────────────────────────────────────────
